{
  "Version": "3",
  "Config": {
    "TCP": {
      "443": { "MustAcceptTLS": true, "ServeURL": "https://build.fangorn.example.com" },
      "8080": { "ServeURL": "http://build.fangorn.example.com:8080" }
    },
    "Web": {
      "build.fangorn.example.com:443": { "Handlers": { "/": { "Proxy": "http://127.0.0.1:3000" } } },
      "build.fangorn.example.com:8080": { "Handlers": { "/": { "Text": "internal dashboard" } } }
    },
    "AllowFunnel": {
      "build.fangorn.example.com:443": true
    }
  }
}
